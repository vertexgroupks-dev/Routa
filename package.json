{
  "name": "routa",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev --workspace @routa/web",
    "dev:driver": "npm --prefix apps/driver start",
    "build": "npm run build --workspace @routa/web",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "install:driver": "npm --prefix apps/driver install"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
